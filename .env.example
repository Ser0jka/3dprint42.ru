# Create .env.local from this template. Never commit the real bot token.
TELEGRAM_BOT_TOKEN=replace_with_new_token_from_botfather
# Legacy bot chat setting.
TELEGRAM_CHAT_ID=replace_with_target_chat_id
# VK and email notifications go to these private Telegram chats (comma-separated).
TELEGRAM_NOTIFY_CHAT_ID=replace_with_private_chat_id,replace_with_second_private_chat_id
# Anonymous website-request alerts. Falls back to TELEGRAM_NOTIFY_CHAT_ID, then TELEGRAM_CHAT_ID.
TELEGRAM_REQUEST_CHAT_ID=replace_with_private_chat_id
TELEGRAM_API_BASE=https://api.telegram.org

# VK community Callback API. The confirmation code is shown by VK when adding the server.
VK_COMMUNITY_ID=replace_with_numeric_community_id
VK_COMMUNITY_SCREEN_NAME=center3dkem
VK_CALLBACK_CONFIRMATION_CODE=replace_with_vk_confirmation_code
VK_CALLBACK_SECRET=replace_with_a_random_secret_at_least_16_characters

# Mail notifier. Use separate application passwords, never the account passwords.
MAIL_YANDEX_USER=sersur42@yandex.ru
MAIL_YANDEX_APP_PASSWORD=replace_with_yandex_app_password
MAIL_GMAIL_USER=sersur2007@gmail.com
MAIL_GMAIL_APP_PASSWORD=replace_with_google_app_password
MAIL_NOTIFIER_STATE_FILE=./data/mail-notifier-state.json
MAIL_NOTIFIER_POLL_SECONDS=45
# Optional comma-separated addresses or domains. Allow-list bypasses automatic filtering.
MAIL_ALLOWED_SENDERS=
MAIL_BLOCKED_SENDERS=

# Admin panel. Use long random values in production.
ADMIN_LOGIN=replace_with_admin_login
ADMIN_PASSWORD=replace_with_a_strong_password
ADMIN_SESSION_SECRET=replace_with_at_least_32_random_characters
# Optional separate secret for team accounts. When empty, ADMIN_SESSION_SECRET is used.
TEAM_SESSION_SECRET=replace_with_at_least_32_random_characters
# Local HTTP production-preview only. Keep unset in production.
# SESSION_COOKIE_SECURE=false
# Keep catalog data outside release folders on the server, e.g. /var/lib/3dprint42
CATALOG_DATA_DIR=./data
